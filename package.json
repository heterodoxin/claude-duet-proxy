  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "node-pty": "1.1.0",
    "playwright-core": "1.65.1",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
